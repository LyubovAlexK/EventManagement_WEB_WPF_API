<UserControl x:Class="EventManagmentApp.CategoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EventManagmentApp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border x:Name="CategoriesPanel" Grid.Column="1" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TextBlockBorder}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/img/Search.png" Style="{StaticResource IconImage}"/>
                        <TextBox x:Name="SearchBox" 
                                 Style="{StaticResource SearchBox}"
                                 TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ButtonBorder}" HorizontalAlignment="Right" Margin="0">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Button x:Name="btnAllRec" 
                                Style="{StaticResource ButtonStyle}" 
                                Content="Обновить данные"
                                Click="btnAllRec_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border>
                        <StackPanel Orientation="Horizontal" Background="Transparent"/>
                    </Border>
                    <Border Style="{StaticResource ButtonBorder}">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Image Source="/img/plus.png" Style="{StaticResource IconImage}"/>
                            <Button x:Name="btnAddNewRec"
                                    Style="{StaticResource ButtonStyle}" 
                                    Content="Добавить"
                                    IsEnabled="{Binding IsUserAdmin}"
                                    Click="AddNewRecord_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ButtonBorder}">
                        <StackPanel Orientation="Horizontal" Background="Transparent" Margin="10,0,10,0">
                            <Image Source="/img/editl.png" Style="{StaticResource IconImage}"/>
                            <Button x:Name="btnEditRec"
                                    Style="{StaticResource ButtonStyle}" 
                                    Content="Редактировать"
                                    IsEnabled="{Binding IsCategorySelectedAndAdmin}"
                                    Click="EditRecord_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ButtonBorder}" Margin="0">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Image Source="/img/trash.png" Style="{StaticResource IconImage}"/>
                            <Button x:Name="btnDelRec"
                                    Style="{StaticResource ButtonStyle}" 
                                    Content="Удалить"
                                    IsEnabled="{Binding IsCategorySelectedAndAdmin}"
                                    Click="DeleteRecord_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <!-- DataGrid -->
                <Border Grid.Row="3" 
                        Style="{StaticResource DataGridBorder}"
                        Margin="10"
                        Visibility="Visible">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid x:Name="CategoriesDataGrid"
                                Style="{StaticResource CustomDataGridStyle}"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                SelectionMode="Single"
                                IsReadOnly="True"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Код категории" 
                                                    Binding="{Binding CategoryId}"
                                                    Width="Auto"
                                                    HeaderStyle="{StaticResource HeaderWithIconStyle}"/>
                                <DataGridTextColumn Header="Название категории"
                                                    Binding="{Binding CategoryName}"
                                                    Width="Auto"
                                                    HeaderStyle="{StaticResource HeaderWithIconStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>