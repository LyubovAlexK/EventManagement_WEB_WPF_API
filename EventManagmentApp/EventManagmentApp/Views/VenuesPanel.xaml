<UserControl x:Class="EventManagmentApp.VenuesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EventManagmentApp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border x:Name="VenuePanel" Grid.Column="1" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TextBlockBorder}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/img/Search.png" Style="{StaticResource IconImage}"/>
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                                 TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ButtonBorder}" HorizontalAlignment="Right" Margin="0">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Button x:Name="btnAllRec" 
                                Style="{StaticResource ButtonStyle}" 
                                Content="Обновить данные"
                                Click="btnAllRec_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Border x:Name="StatusFilterContainer" Style="{StaticResource TextBlockBorder}">
                        <StackPanel x:Name="StatusFilter" Orientation="Horizontal" Background="Transparent">
                            <Button x:Name="btnCapacityFilter" 
                                    Style="{StaticResource FilterButton}" 
                                    Content="Вместимость"/>
                            <Image x:Name="ArowCapacityFilter"
                                   Source="/img/ArowDown.png"
                                   Style="{StaticResource IconImage}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border>
                        <StackPanel Orientation="Horizontal" Background="Transparent"/>
                    </Border>
                    <Border Style="{StaticResource ButtonBorder}">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Image Style="{StaticResource IconImage}" Source="/img/plus.png"/>
                            <Button x:Name="btnAddNewRec"
                                    Style="{StaticResource ButtonStyle}"
                                    Content="Добавить"
                                    Click="AddNewRecord_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ButtonBorder}" x:Name="btnEdit">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Image Style="{StaticResource IconImage}" Source="/img/editl.png"/>
                            <Button x:Name="btnEditRec"
                                    Style="{StaticResource ButtonStyle}"
                                    IsEnabled="{Binding IsVenueSelected}"
                                    Content="Редактировать"
                                    Click="EditVenue_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ButtonBorder}" Margin="0">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Image Style="{StaticResource IconImage}" Source="/img/trash.png"/>
                            <Button x:Name="btnDelRec"
                                    Style="{StaticResource ButtonStyle}"
                                    IsEnabled="{Binding IsVenueSelected}"
                                    Content="Удалить"
                                    Click="DeleteVenue_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- DataGrid -->
            <Border Grid.Row="2" 
                    Style="{StaticResource DataGridBorder}"
                    Margin="10"
                    Panel.ZIndex="0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid x:Name="VenuesDataGrid"
                              Style="{StaticResource CustomDataGridStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              ItemsSource="{Binding Venues}"
                              SelectedItem="{Binding SelectedVenue, Mode=TwoWay}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код места" 
                                                Binding="{Binding VenueId}"
                                                Width="Auto"
                                                HeaderStyle="{StaticResource HeaderWithIconStyle}"/>
                            <DataGridTextColumn Header="Название места"
                                                Binding="{Binding VenueName}"
                                                Width="Auto"
                                                HeaderStyle="{StaticResource HeaderWithIconStyle}"/>
                            <DataGridTextColumn Header="Адрес" 
                                                Binding="{Binding Address}"
                                                Width="Auto"
                                                HeaderStyle="{StaticResource HeaderWithIconStyle}"/>
                            <DataGridTextColumn Header="Вместимость" 
                                                Binding="{Binding Capacity}"
                                                Width="Auto"
                                                HeaderStyle="{StaticResource HeaderWithIconStyle}"/>
                            <DataGridTextColumn Header="Описание" 
                                                Binding="{Binding Description}"
                                                Width="Auto"
                                                HeaderStyle="{StaticResource HeaderWithIconStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </Border>

            <Canvas Grid.Row="2" Panel.ZIndex="100">
                <Border x:Name="MenuCapacityFilterContainer"
                        Style="{StaticResource TextBlockBorder}" 
                        Canvas.Left="10"
                        Canvas.Top="10"
                        Visibility="Hidden">
                    <Grid x:Name="MenuCapacityFilter" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                   Style="{StaticResource FilterBlock}" Text="От" 
                                   Padding="5" VerticalAlignment="Center" Margin="0,0,10,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                   Style="{StaticResource FilterBlock}" Text="До" 
                                   Padding="5" VerticalAlignment="Center" Margin="0,0,0,5"/>

                        <Border Grid.Row="1" Grid.Column="0" 
                                Style="{StaticResource TextBlockBorder}" 
                                Margin="0,0,10,10">
                            <TextBox x:Name="StartCapacityFilter" Style="{StaticResource InputBox}" Width="80"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" 
                                Style="{StaticResource TextBlockBorder}" 
                                Margin="0,0,0,10">
                            <TextBox x:Name="FinishCapacityFilter" Style="{StaticResource InputBox}" Width="80"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                Style="{StaticResource ButtonBorder}" 
                                HorizontalAlignment="Center">
                            <Button Style="{StaticResource ButtonStyle}" Content="Применить"
                                    Click="ApplyCapacityFilter_Click"/>
                        </Border>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>
    </Border>
</UserControl>