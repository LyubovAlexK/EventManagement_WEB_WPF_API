<UserControl x:Class="EventManagmentApp.SettingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EventManagmentApp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с заголовком и ролью -->
        <Border Grid.Row="0" Background="White" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                          Text="Настройки" 
                          Style="{StaticResource H1Text}"
                          Foreground="#1E293B"
                          VerticalAlignment="Center"
                          Margin="15,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="Роль:" 
                              Style="{StaticResource H3Text}"
                              Foreground="#1E293B"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="RoleText" 
                              Text="{Binding CurrentUserRole}"
                              Style="{StaticResource H1Text}"
                              Foreground="{DynamicResource PrimaryBrush}"
                              VerticalAlignment="Center"
                              Margin="15,0,0,0"
                              Padding="5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель управления -->
            <Border Grid.Column="0" 
                    Background="White" 
                    CornerRadius="8"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Настройки" 
                              Style="{StaticResource H2Text}"
                              Foreground="#1E293B"
                              Margin="15,15,15,10"/>

                    <Button x:Name="AppearanceButton"
                            Style="{StaticResource SettingPanelButton}"
                            Tag="Appearance"
                            Click="SettingButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Внешний вид и темы" 
                                       VerticalAlignment="Center"
                                       Style="{StaticResource H3Text}"
                                       Foreground="#1E293B"
                                       TextWrapping="Wrap"
                                       MaxWidth="220"/>
                        </Grid>
                    </Button>

                    <Button x:Name="ZoomButton"
                            Style="{StaticResource SettingPanelButton}"
                            Tag="Zoom"
                            Click="SettingButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Масштабирование интерфейса" 
                                       VerticalAlignment="Center"
                                       Style="{StaticResource H3Text}"
                                       Foreground="#1E293B"
                                       TextWrapping="Wrap"
                                       MaxWidth="220"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Правая панель настроек -->
            <Border Grid.Column="2" 
                    Background="White" 
                    CornerRadius="8"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Padding="20">
                <ContentControl x:Name="SettingsContentControl"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>