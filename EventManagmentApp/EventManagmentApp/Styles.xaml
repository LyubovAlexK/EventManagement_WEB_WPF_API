<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:EventManagmentApp">


    <sys:Double x:Key="SmallScale">0.8</sys:Double>
    <sys:Double x:Key="MediumScale">1.0</sys:Double>
    <sys:Double x:Key="LargeScale">1.2</sys:Double>

    <!-- Базовые размеры для разных масштабов -->
    <sys:Double x:Key="SmallIconWidth">16</sys:Double>
    <sys:Double x:Key="SmallIconHeight">16</sys:Double>
    <sys:Double x:Key="MediumIconWidth">20</sys:Double>
    <sys:Double x:Key="MediumIconHeight">20</sys:Double>
    <sys:Double x:Key="LargeIconWidth">24</sys:Double>
    <sys:Double x:Key="LargeIconHeight">24</sys:Double>

    <sys:Double x:Key="SmallButtonIconWidth">24</sys:Double>
    <sys:Double x:Key="SmallButtonIconHeight">24</sys:Double>
    <sys:Double x:Key="MediumButtonIconWidth">30</sys:Double>
    <sys:Double x:Key="MediumButtonIconHeight">30</sys:Double>
    <sys:Double x:Key="LargeButtonIconWidth">36</sys:Double>
    <sys:Double x:Key="LargeButtonIconHeight">36</sys:Double>

    <!-- Размеры шрифтов для разных масштабов -->
    <sys:Double x:Key="SmallAppFontSizeBig">28</sys:Double>
    <sys:Double x:Key="SmallAppFontSizeH1">20</sys:Double>
    <sys:Double x:Key="SmallAppFontSizeH2">18</sys:Double>
    <sys:Double x:Key="SmallAppFontSizeH3">16</sys:Double>
    <sys:Double x:Key="SmallAppFontSizeH4">14</sys:Double>
    <sys:Double x:Key="SmallWindowFormFontSize">12</sys:Double>

    <sys:Double x:Key="MediumAppFontSizeBig">36</sys:Double>
    <sys:Double x:Key="MediumAppFontSizeH1">24</sys:Double>
    <sys:Double x:Key="MediumAppFontSizeH2">22</sys:Double>
    <sys:Double x:Key="MediumAppFontSizeH3">20</sys:Double>
    <sys:Double x:Key="MediumAppFontSizeH4">18</sys:Double>
    <sys:Double x:Key="MediumWindowFormFontSize">14</sys:Double>

    <sys:Double x:Key="LargeAppFontSizeBig">44</sys:Double>
    <sys:Double x:Key="LargeAppFontSizeH1">28</sys:Double>
    <sys:Double x:Key="LargeAppFontSizeH2">26</sys:Double>
    <sys:Double x:Key="LargeAppFontSizeH3">24</sys:Double>
    <sys:Double x:Key="LargeAppFontSizeH4">22</sys:Double>
    <sys:Double x:Key="LargeWindowFormFontSize">16</sys:Double>
    
    <!-- Темный цвет для текста -->
    <Color x:Key="DarkTextColor">#FF1E293B</Color>
    <SolidColorBrush x:Key="DarkTextBrush" Color="{DynamicResource DarkTextColor}"/>
    
    <!-- Базовые цветовые ресурсы -->
    <Color x:Key="PrimaryColor">#FF6F51FF</Color>
    <Color x:Key="PrimaryColor40">#FFB1A1FF</Color>
    <Color x:Key="PrimaryColor30">#FFE5E0FF</Color>
    <Color x:Key="BackgroundColor">White</Color>
    <Color x:Key="TextColor">#FF1E293B</Color>
    <Color x:Key="BorderColor">#FFCBD5E1</Color>
    <Color x:Key="PanelBackground">Transparent</Color>
    <!-- Изменено на прозрачный -->
    <Color x:Key="HeaderBackground">White</Color>
    <Color x:Key="HoverColor">#FFE5E0FF</Color>
    <Color x:Key="SecondaryTextColor">#FF6B7D96</Color>

    <!-- SolidColorBrush ресурсы -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush40" Color="{DynamicResource PrimaryColor40}"/>
    <SolidColorBrush x:Key="PrimaryBrush30" Color="{DynamicResource PrimaryColor30}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource PanelBackground}"/>
    <!-- Прозрачный фон панелей -->
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{DynamicResource HeaderBackground}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryTextColor}"/>

    <!-- Значения -->
    <sys:Double x:Key="DefaultIconWidth">20</sys:Double>
    <sys:Double x:Key="DefaultIconHeight">20</sys:Double>

    <sys:Double x:Key="ButtonIconWidth">30</sys:Double>
    <sys:Double x:Key="ButtonIconHeight">30</sys:Double>

    <sys:Double x:Key="AppFontSizeBig">36</sys:Double>
    <sys:Double x:Key="AppFontSizeH1">24</sys:Double>
    <sys:Double x:Key="AppFontSizeH2">22</sys:Double>
    <sys:Double x:Key="AppFontSizeH3">20</sys:Double>
    <sys:Double x:Key="AppFontSizeH4">18</sys:Double>
    <sys:Double x:Key="WindowFormFontSize">14</sys:Double>

    <!-- Общая настройка окон -->

    <!-- Скругленные углы формы -->
    <Style x:Key="WindowControlButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="FontSize" Value="{DynamicResource WindowFormFontSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush30}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RoundedWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{DynamicResource BackgroundBrush}" 
                            CornerRadius="12"
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="HeaderBorder" 
                                Grid.Row="0" 
                                    Background="{DynamicResource HeaderBackgroundBrush}" 
                                    Height="40"
                                    CornerRadius="12,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{TemplateBinding Title}"
                                              VerticalAlignment="Center"
                                              Margin="15,0"
                                              Foreground="{DynamicResource TextBrush}"
                                              FontSize="14"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="─"
                                                Foreground="{DynamicResource TextBrush}"
                                                Style="{StaticResource WindowControlButtonStyle}"
                                                Command="{x:Static local:WindowCommand.MinimizeCommand}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Button Content="×"
                                                Foreground="{DynamicResource TextBrush}"
                                                Style="{StaticResource WindowControlButtonStyle}"
                                                Command="{x:Static local:WindowCommand.CloseCommand}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Row="1"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid -->
    <Style x:Key="DataGridBorder" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="CustomDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <!-- Всегда белый -->
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH4}"/>
        <Setter Property="RowHeight" Value="40"/>

        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserReorderColumns" Value="True"/>

        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="FontFamily" Value="JetBrains Mono"/>
                </Style>
            </Setter.Value>
        </Setter>

        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
                    <!-- Добавлено -->
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush30}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
                            <!-- Добавлено -->
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>

        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <!-- Всегда белый -->
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush30}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush30}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeaderWithIconStyle" TargetType="DataGridColumnHeader">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <!-- Добавлено -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}" 
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"
                                       TextTrimming="CharacterEllipsis"
                                       Background="White"
                                       Foreground="{DynamicResource DarkTextBrush}"
                                       FontWeight="SemiBold"
                                       Padding="2"
                                       FontFamily="JetBrains Mono"/>
                                <Image Source="/img/up-down-arow.png" 
                                   Width="{DynamicResource DefaultIconWidth}" 
                                   Height="{DynamicResource DefaultIconHeight}" 
                                   VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- CheckBox -->
    <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="OuterBorder"
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,0,8,0">

                            <Path x:Name="CheckMark"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Fill="White"
                              Data="M0,6 L3,9 L9,3 L8,2 L3,7 L1,5 Z"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Opacity="0"/>
                        </Border>

                        <ContentPresenter Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Margin="2,0,0,0"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#999999"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#F0F0F0"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#DDDDDD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MainWindow -->

    <!-- Button -->
    <Style x:Key="ButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button Border -->
    <Style x:Key="ButtonBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,20,0"/>
    </Style>

    <!-- Text Border -->
    <Style x:Key="TextBlockBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="White"/>
        <!-- Всегда белый -->
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,20,0"/>
        <Setter Property="Padding" Value="5"/>
    </Style>

    <!-- Поиск TextBox -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <!-- Icon для Image -->
    <Style x:Key="IconImage" TargetType="Image">
        <Setter Property="Width" Value="{DynamicResource DefaultIconWidth}"/>
        <Setter Property="Height" Value="{DynamicResource DefaultIconHeight}"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <!-- Icon для Button -->
    <Style x:Key="IconButton" TargetType="Image">
        <Setter Property="Width" Value="{DynamicResource ButtonIconWidth}"/>
        <Setter Property="Height" Value="{DynamicResource ButtonIconHeight}"/>
    </Style>

    <!-- Ввод значений TextBox -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Margin" Value="1"/>
    </Style>

    <!-- Ввод значений DatePicker -->
    <Style x:Key="DatePickerBox" TargetType="DatePicker">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="CalendarStyle" Value="{StaticResource DatePickerCalendarStyle}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush30}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ввод значений ComboBox -->
    <Style x:Key="CustomComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="CustomComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush30}"/>
                <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush30}"/>
                <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ввод значений TextBox -->
    <Style x:Key="InputPassBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{DynamicResource DarkTextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="PasswordChar" Value="•"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Margin" Value="1"/>
    </Style>

    <!-- Фильтр Button -->
    <Style x:Key="FilterButton" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <!-- Всегда белый -->
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Фильтр TextBlock -->
    <Style x:Key="FilterBlock" TargetType="TextBlock">
        <Setter Property="Background" Value="White"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>

    <!-- Button для SIDEBAR -->
    <Style x:Key="SidebarButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH2}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="Foreground" Value="#F8FAFC"/>
    </Style>

    <!-- Border для SIDEBAR -->
    <Style x:Key="SidebarBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="0,30,30,0"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Border для LeftSettingPanel -->
    <Style x:Key="LeftSettingPanel" TargetType="Border">
        <Setter Property="CornerRadius" Value="0,30,30,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <!-- Текст большой -->
    <Style x:Key="MainText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBig}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Текст заголовка H1 -->
    <Style x:Key="H1Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH1}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Текст заголовка H1 для Sidebar - всегда белый -->
    <Style x:Key="H1TextSidedar" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH1}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Текст заголовка H3 для Sidebar - всегда белый -->
    <Style x:Key="H3TextSidedar" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontWeight" Value="ExtraLight"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Текст заголовка H2 -->
    <Style x:Key="H2Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH2}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- Текст заголовка H3 -->
    <Style x:Key="H3Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH3}"/>
        <Setter Property="FontWeight" Value="ExtraLight"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- Стиль иконок -->
    <Style x:Key="IconStyle" TargetType="Image">
        <Setter Property="Width" Value="{DynamicResource DefaultIconWidth}"/>
        <Setter Property="Height" Value="{DynamicResource DefaultIconHeight}"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <!-- Стиль для кнопок с иконками -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource ButtonIconWidth}"/>
        <Setter Property="Height" Value="{DynamicResource ButtonIconHeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- CalendarDayButton Style -->
    <Style x:Key="DatePickerCalendarDayButtonStyle" TargetType="CalendarDayButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH4}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource PrimaryBrush30}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Background" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Calendar Style для DatePicker -->
    <Style x:Key="DatePickerCalendarStyle" TargetType="Calendar">
        <Setter Property="Background" Value="White"/>
        <!-- Всегда белый -->
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeH4}"/>
    </Style>

    <!-- Button Template для DatePicker -->
    <ControlTemplate x:Key="DatePickerButtonTemplate" TargetType="Button">
        <Grid>
            <Border Background="Transparent"
                    BorderThickness="0"
                    Padding="5">
                <Path x:Name="CalendarIcon"
                      Data="M2,2 L14,2 L14,14 L2,14 L2,2 Z M1,6 L15,6 M4,0 L4,4 M12,0 L12,4"
                      Stroke="{DynamicResource TextBrush}"
                      StrokeThickness="1.5"
                      Stretch="Uniform"
                      Width="16"
                      Height="16"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CalendarIcon" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CalendarIcon" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Стиль для кнопок в панели настроек -->
    <Style x:Key="SettingPanelButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="JetBrains Mono"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,12"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="50"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderThickness="0">
                        <Grid>
                            <Border x:Name="highlightBorder" 
                            Width="10" 
                            HorizontalAlignment="Left" 
                            Background="Transparent"/>
                            <ContentPresenter HorizontalAlignment="Stretch"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="10,5"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryBrush30}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryBrush30}"/>
                            <Setter TargetName="highlightBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для ToggleButton -->
    <Style x:Key="SettingToggleButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border" 
                        Background="{TemplateBinding Background}"
                        CornerRadius="12.5">
                        <Grid>
                            <Ellipse x:Name="thumb"
                                 Width="21"
                                 Height="21"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="2"
                                 Fill="White"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для CheckBox выбора цветовой темы -->
    <Style x:Key="ColorThemeCheckBox" TargetType="CheckBox">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="OuterBorder"
                            Width="40"
                            Height="40"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="2"
                            CornerRadius="4">
                            <Path x:Name="CheckMark"
                              Width="20"
                              Height="20"
                              Stretch="Uniform"
                              Fill="White"
                              Data="M0,6 L3,9 L9,3 L8,2 L3,7 L1,5 Z"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Opacity="0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                            <Setter TargetName="OuterBorder" Property="BorderThickness" Value="3"/>
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- стиль для прозрачных панелей -->
    <Style x:Key="TransparentPanelBorder" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</ResourceDictionary>